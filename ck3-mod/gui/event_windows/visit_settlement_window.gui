big_event_window = {
	name = "visit_settlement_window"

	blockoverride "transition" {

		state = {
			name = show
			trigger_on_create = yes
			using = Animation_FadeIn_Standard
			duration = 0
			delay = 0.1
			next = tts_clear_hide_characters

			on_start = "[PdxGuiWidget.AccessChild('tts_on_top_tracker').TriggerAnimation('tts_initial_check')]"
			on_finish = "[GetVariableSystem.Clear( 'event_window_mouse_leave')]"
		}

		state = {
			name = tts_clear_hide_characters
			using = Animation_FadeIn_Standard
			on_start = "[GetVariableSystem.Clear( 'hide_characters')]" } state = { name = tts_visit_settlement_speak_ref on_start = "[EventWindowData.CopyStringToClipboard(Concatenate('##CK3_TTS## ', Concatenate(EventWindowData.GetTitle, Concatenate('|||', Concatenate(EventWindowData.GetDescription, Select_CString( EventWindowData.HasPortraitCharacter('right_portrait'), Select_CString( EventWindowData.GetPortraitCharacter('right_portrait').IsFemale, '|||GENDER:F##CK3_TTS_END##', '|||GENDER:M##CK3_TTS_END##' ), Select_CString( EventWindowData.HasPortraitCharacter('center_portrait'), Select_CString( EventWindowData.GetPortraitCharacter('center_portrait').IsFemale, '|||GENDER:F##CK3_TTS_END##', '|||GENDER:M##CK3_TTS_END##' ), Select_CString( EventWindowData.HasPortraitCharacter('left_portrait'), Select_CString( EventWindowData.GetPortraitCharacter('left_portrait').IsFemale, '|||GENDER:F##CK3_TTS_END##', '|||GENDER:M##CK3_TTS_END##' ), '##CK3_TTS_END##' ) ) ))))))]"
		}

		# Sound-only state: start_sound is skipped on zero-duration states, so it cannot live in show above
		state = {
			name = panel_sound
			trigger_on_create = yes
			duration = 0.1

			start_sound = {
				soundeffect = "event:/SFX/Events/Panels/sfx_event_panel_large"

				soundparam = {
					name = StateChange
					value = 1
				}
			}
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Standard
			duration = 0
		}
	}

	blockoverride "transition_text" {
	}

	blockoverride "transition_left_character" {
	}

	blockoverride "transition_center_character" {
	}

	blockoverride "transition_right_character" {
	}

}
